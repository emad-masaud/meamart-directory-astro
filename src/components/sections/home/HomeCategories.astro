---
import { useTranslations } from "~/i18n/utils";
import { defaultLang } from "~/i18n/ui";
import { categoriesStructure, categoryStyles } from "~/utils/categories";
import { Icon } from "astro-icon/components";

interface Props {
  lang?: string;
}

const { lang = defaultLang } = Astro.props as Props;
const t = useTranslations(lang);

// icon component mapping removed in favor of dynamic astro-icon name

const items = categoriesStructure.map((group) => {
  const style = categoryStyles[group.key] || {
    bg: "bg-zinc-50 dark:bg-zinc-800/30",
    text: "text-zinc-650 dark:text-zinc-300",
    border: "border-zinc-150 dark:border-zinc-800/30",
    hoverBg: "group-hover:bg-zinc-600",
    hoverText: "group-hover:text-white",
  };

  return {
    key: group.key,
    label: lang === "ar" ? group.labelAr : group.labelEn,
    href: `/${lang}/ads?category=${group.key}`,
    icon: group.icon,
    style,
  };
});
---

<!-- قسم الفئات — سلايدر في الجوال وشبكة في الديسك توب -->
<section
  class="py-12 bg-zinc-50/50 dark:bg-zinc-900/10 border-b border-zinc-100 dark:border-zinc-800/60"
>
  <div class="container mx-auto px-6">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50">
        {t["categories.title"] || "الأقسام الرئيسية"}
      </h2>
      <a
        href={`/${lang}/categories`}
        class="text-sm font-semibold text-primary hover:underline"
      >
        {t["categories.view_all"] || "عرض الكل"}
      </a>
    </div>

    <div
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 py-4"
    >
      {
        items.map((item) => {
          const iconName = `lucide:${(item.icon || "Tag").replace(/([a-z])([A-Z0-9])/g, "$1-$2").toLowerCase()}`;
          return (
            <a
              href={item.href}
              class="group flex flex-col items-center justify-center rounded-2xl border border-zinc-200/50 bg-white p-6 text-center transition-all duration-300 hover:border-primary/20 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40 hover:-translate-y-1"
            >
              <div
                class={`mb-4 flex h-14 w-14 items-center justify-center rounded-full border ${item.style.bg} ${item.style.text} ${item.style.border} transition-all duration-300 ${item.style.hoverBg} ${item.style.hoverText} shadow-xs`}
              >
                <Icon
                  name={iconName}
                  class="h-6 w-6 transition-transform duration-300 group-hover:scale-110"
                />
              </div>
              <span class="text-sm font-bold text-zinc-800 dark:text-zinc-200 group-hover:text-primary transition-colors line-clamp-1">
                {item.label}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
