            />
          </div>
          <Icon name="lucide:chevron-down"
            class="w-4 h-4 text-foreground/70 group-hover:text-foreground transition-colors"
          />
        </button>

        <div
          class="absolute ltr:right-0 rtl:left-0 ltr:origin-top-right rtl:origin-top-left z-50 mt-2 w-56 rounded-xl border border-zinc-200/50 bg-white/95 p-2 shadow-xl backdrop-blur-md focus:outline-hidden dark:border-zinc-800/50 dark:bg-zinc-900/95 hidden transition-all duration-200 transform scale-95 opacity-0"
          id="header-user-dropdown-menu"
          role="menu"
          aria-orientation="vertical"
          aria-labelledby="user-dropdown-btn"
        >
          <div
            class="px-3 py-2.5 border-b border-zinc-100 dark:border-zinc-800/60 mb-1.5"
          >
            <p class="text-xs font-semibold text-zinc-400">
              {t["user.welcome"]}
            </p>
            <p
              class="text-sm font-bold text-zinc-800 dark:text-zinc-200 truncate"
              id="header-user-name"
            >
              User
            </p>
          </div>

          <a
            href={`/${lang}/dashboard`}
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-xl text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800/50 transition-colors"
            role="menuitem"
          >
            <Icon name="lucide:layout-grid" class="w-4 h-4 text-primary" />
            <span>{t["user.myAds"]}</span>
          </a>

          <a
            href={`/${lang}/seller/products`}
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-xl text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800/50 transition-colors"
            role="menuitem"
          >
            <Icon name="lucide:shopping-bag" class="w-4 h-4 text-primary" />
            <span>{t["user.myProducts"]}</span>
          </a>

          <a
            href={`/${lang}/seller/addresses`}
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-xl text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800/50 transition-colors"
            role="menuitem"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-map-pin w-4 h-4 text-primary"
              ><path
                d="M20 10c0 4.993-5.539 10.193-7.399 11.74a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"
              ></path><circle cx="12" cy="10" r="3"></circle></svg
            >
            <span>{t["user.myAddresses"]}</span>
          </a>

          <a
            href={`/${lang}/seller/qr-manager`}
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-xl text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800/50 transition-colors"
            role="menuitem"
          >
            <Icon name="lucide:qr-code" class="w-4 h-4 text-primary" />
            <span
              >{
                t["seller.subnav.qr"] ||
                  (lang === "ar" ? "Ø§Ù„Ø¨Ø§Ø±ÙƒÙˆØ¯ ÙˆØ§Ù„Ø±Ø§Ø¨Ø· Ø§Ù„Ù…ÙˆØ­Ø¯" : "QR & Bio Link")
              }</span
            >
          </a>

          <a
            href={`/${lang}/seller/profile`}
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-xl text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800/50 transition-colors"
            role="menuitem"
          >
            <Icon name="lucide:user" class="w-4 h-4 text-primary" />
            <span>{t["user.profile"]}</span>
          </a>

          <div class="border-t border-zinc-100 dark:border-zinc-800/60 my-1.5">
          </div>

          <a
            href="/api/auth/logout"
            class="flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-xl text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/20 transition-colors"
            role="menuitem"
            id="header-logout-link"
          >
            <Icon name="lucide:log-out" class="w-4 h-4" />
            <span>{t["user.signOut"]}</span>
          </a>
        </div>
      </div>

      <!-- Primary Action Button (Create Ad) -->
      <a
        id="header-create-ad-btn"
        href={`/${lang}/ads/create`}
        class="hidden items-center justify-center rounded-full bg-primary text-white p-2.5 hover:bg-primary/90 transition-all shadow-xs rtl:ml-2 ltr:mr-2"
        aria-label={t["hero.getStarted"] || ACTION_LINKS.primary.label}
      >
        <Icon name="lucide:plus" class="w-5 h-5" aria-hidden="true" />
      </a>
      
      <!-- Primary Action Button (WhatsApp) -->
      {
        (() => {
          const whatsappNum = siteConfig?.contact?.phone?.main?.replace(/[^0-9]/g, "") || "15559607109";
          const whatsappUrl = `https://wa.me/${whatsappNum}?text=${encodeURIComponent(
            lang === "ar"
              ? "ياهلا, أبي أنشر إعلان"
              : "Hello, I want to post an ad",
          )}`;
          return (
            <a
              id="header-whatsapp-ad-btn"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hidden md:inline-flex items-center justify-center rounded-full bg-emerald-500 text-white p-2.5 hover:bg-emerald-600 transition-all shadow-xs rtl:ml-2 ltr:mr-2"
              aria-label="Create Ad via WhatsApp"
            >
              <Icon name="lucide:plus" class="w-5 h-5" aria-hidden="true" />
            </a>
          );
        })()
      }

      <!-- Logged-out State (hidden by default, shown via client-side script) -->
      {
        siteConfig.features.auth && !url.pathname.includes('/admin') ? (
          <div class="items-center gap-3 hidden" id="header-login-btn">
            <a
              href={`/${lang}/login`}
              class="text-sm font-bold text-zinc-700 hover:text-primary dark:text-zinc-300 dark:hover:text-white transition-colors"
            >
              {t["login.tab.signin"]}
            </a>
          </div>
        ) : null
      }


      <div class="md:hidden">
        <MobileMenu
          client:load
          links={links}
          currentPath={Astro.url.pathname}
          labels={{
            menu: t["nav.menu"],
            getStarted: t["hero.getStarted"] || ACTION_LINKS.primary.label,
          }}
          userSession={userSession}
          lang={lang}
          availableLangs={availableLangs && availableLangs.length > 1
            ? availableLangs
            : Object.keys(languages)}
        >
          <div class="flex items-center justify-center gap-8 mt-2">
            <LanguagePicker availableLangs={availableLangs} />
            <ThemeToggle />
          </div>
        </MobileMenu>
      </div>
    </div>
  </div>
</header>

<script>
  function updateHeaderAuthUI() {
    const sessionStr = localStorage.getItem("meamart_session_active");
    const dropdown = document.getElementById("header-user-dropdown");
    const loginBtn = document.getElementById("header-login-btn");
    const lang = window.location.pathname.split("/")[1] || "ar";

    if (sessionStr) {
      try {
        const session = JSON.parse(sessionStr);
        if (session && session.name) {
          // Update user details
          const nameEl = document.getElementById("header-user-name");
          if (nameEl) nameEl.textContent = session.name;

          const avatarImg = document.getElementById(
            "header-avatar-img",
          ) as HTMLImageElement;
          const avatarInitials = document.getElementById(
            "header-avatar-initials",
          );

          if (session.avatar && avatarImg) {
            avatarImg.src = session.avatar;
            avatarImg.classList.remove("hidden");
            if (avatarInitials) avatarInitials.classList.add("hidden");
          } else if (avatarInitials) {
            const isArabic = /[\u0600-\u06FF]/.test(session.name);
            let initial = session.name.charAt(0);
            if (isArabic && session.email) {
              initial = session.email.charAt(0);
            }
            avatarInitials.textContent = initial.toUpperCase();
            avatarInitials.classList.remove("hidden");
            if (avatarImg) avatarImg.classList.add("hidden");
          }

          // Show dropdown, hide login
          if (dropdown) {
            dropdown.classList.remove("hidden");
            dropdown.classList.add("inline-block");
          }
          if (loginBtn) {
            loginBtn.classList.add("hidden");
            loginBtn.classList.remove("flex");
          }
          const createAdBtn = document.getElementById("header-create-ad-btn");
          const whatsappAdBtn = document.getElementById("header-whatsapp-ad-btn");

          if (createAdBtn) {
            createAdBtn.classList.remove("hidden");
            createAdBtn.classList.add("md:inline-flex");
          }
          if (whatsappAdBtn) {
            whatsappAdBtn.classList.add("hidden");
            whatsappAdBtn.classList.remove("md:inline-flex");
          }

          return;
        }
      } catch (e) {
        console.error(
          "Failed to parse session from localStorage in Header:",
          e,
        );
      }
    }

    // Fallback: logged out state
    if (dropdown) {
      dropdown.classList.add("hidden");
      dropdown.classList.remove("inline-block");
    }
    if (loginBtn && !window.location.pathname.includes('/admin')) {
      loginBtn.classList.remove("hidden");
      loginBtn.classList.add("flex");
    }
    
    const createAdBtn = document.getElementById("header-create-ad-btn");
    const whatsappAdBtn = document.getElementById("header-whatsapp-ad-btn");
    if (createAdBtn) {
      createAdBtn.classList.add("hidden");
      createAdBtn.classList.remove("md:inline-flex");
    }
    if (whatsappAdBtn) {
      whatsappAdBtn.classList.remove("hidden");
      whatsappAdBtn.classList.add("md:inline-flex");
    }

  }

  // Run immediately
  updateHeaderAuthUI();

  // Listen to localstorage updates to keep UI synchronized
  window.addEventListener("storage", (e) => {
    if (e.key === "meamart_session_active") {
      updateHeaderAuthUI();
    }
  });

  // Listen to custom session-update event from same window
  window.addEventListener("session-update", () => {
    updateHeaderAuthUI();
  });

  // Dropdown menu toggle
  const btn = document.getElementById("user-dropdown-btn");
  const menu = document.getElementById("header-user-dropdown-menu");

  if (btn && menu) {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();

      const isHidden = menu.classList.contains("hidden");
      if (isHidden) {
        menu.classList.remove("hidden");
        setTimeout(() => {
          menu.classList.remove("scale-95", "opacity-0");
          menu.classList.add("scale-100", "opacity-100");
        }, 10);
      } else {
        menu.classList.remove("scale-100", "opacity-100");
        menu.classList.add("scale-95", "opacity-0");
        setTimeout(() => {
          menu.classList.add("hidden");
        }, 150);
      }
    });

    document.addEventListener("click", () => {
      if (!menu.classList.contains("hidden")) {
        menu.classList.remove("scale-100", "opacity-100");
        menu.classList.add("scale-95", "opacity-0");
        setTimeout(() => {
          menu.classList.add("hidden");
        }, 150);
      }
    });
  }

  // Clear localStorage on logout click
  const logoutBtn = document.getElementById("header-logout-link");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", () => {
      localStorage.removeItem("meamart_session_active");
      localStorage.removeItem("meamart_session_timestamp");
    });
  }
</script>



