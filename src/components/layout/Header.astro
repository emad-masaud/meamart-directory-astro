            />
          ))
      }
      <div class="hidden md:flex flex-col items-start justify-center">
        <span class="font-bold leading-tight text-lg">{t["brand.name"] || siteConfig.name}</span>
        <span class="text-[11px] text-muted-foreground/80 leading-tight mt-0.5 font-medium">
          {lang === "ar" ? "طلباتك أوامر" : "Your Wishes Are Commands"}
        </span>
      </div>
    </a>
    <div class="flex-1 hidden lg:flex justify-center mx-4 lg:mx-8">
      <div class="flex gap-4">{links.map((link: any) => (<a href={link.href} class="text-sm font-bold">{link.label}</a>))}</div>
    </div>

    {/* Mobile/Flyout Menu */}
    <div class="flex items-center gap-2 shrink-0">
      {
        siteConfig.features.search && (
          <Search 
            client:only="react" 
            lang={lang} 
            placeholder={t["search.placeholder"] || "Search..."}
            devModalLabels={{
              title: t["search.dev.title"] || "Search is a Production Superpower! 🚀",
              description: t["search.dev.desc"] || "To enable our lightning-fast search, Pagefind needs a static build index. Run the following command to see it in action:",
              gotIt: t["search.dev.gotIt"] || "Got it, thanks!",
              doc: t["search.dev.doc"] || "Documentation"
            }}
          />
        )
      }
      <LanguagePicker availableLangs={availableLangs} />
      <CurrencyPicker />
      <div class="hidden md:flex items-center gap-2 shrink-0">
        <ThemeToggle />
      </div>

      <!-- Logged-in State (hidden by default, shown via client-side script) -->
      <div
        class="relative ltr:text-left rtl:text-right hidden"
        id="header-user-dropdown"
      >
        <button
          type="button"
          class="flex items-center gap-2 focus:outline-hidden group"
          id="user-dropdown-btn"
          aria-expanded="false"
          aria-haspopup="true"
        >
