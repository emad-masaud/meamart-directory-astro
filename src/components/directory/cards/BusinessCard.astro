---
import { Icon } from "astro-icon/components";
const { business, lang = "ar" } = Astro.props;

const isArabic = lang === "ar";
const title = isArabic ? business.nameAr : business.nameEn;
const description = isArabic ? business.descriptionAr : business.descriptionEn;
const href = `/${lang}/businesses/${business.slug}`;
---

<a href={href} class="block border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group relative">
  <div class="relative h-48 w-full bg-gray-100 dark:bg-gray-700">
    {business.coverImage ? (
      <img src={business.coverImage} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-400">
        <Icon name="tabler:photo" class="w-12 h-12" />
      </div>
    )}
    
    {business.logo && (
      <div class="absolute -bottom-6 ltr:left-4 rtl:right-4 bg-white dark:bg-gray-800 p-1 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700">
        <img src={business.logo} alt={title} class="w-12 h-12 object-contain rounded-md" />
      </div>
    )}
  </div>
  
  <div class="p-5 pt-8">
    <h3 class="font-bold text-lg text-gray-900 dark:text-white line-clamp-1 group-hover:text-primary-600 transition-colors">
      {title}
    </h3>
    <p class="text-gray-500 dark:text-gray-400 text-sm mt-2 line-clamp-2">
      {description}
    </p>
    
    <div class="mt-4 flex items-center gap-4 text-xs text-gray-500 dark:text-gray-400">
      {business.city && (
        <span class="flex items-center gap-1">
          <Icon name="tabler:map-pin" class="w-4 h-4" />
          {business.city}
        </span>
      )}
      {business.category && (
        <span class="flex items-center gap-1">
          <Icon name="tabler:category" class="w-4 h-4" />
          {business.category}
        </span>
      )}
    </div>
  </div>
</a>
