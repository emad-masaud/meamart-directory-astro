---
import AppLogo from "./Logo.astro";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
const isArabic = !currentPath.startsWith('/en');
const lang = isArabic ? "ar" : "en";

const socials = [
  { name: "Twitter", link: "https://twitter.com/meamart", icon: "tabler:brand-twitter" },
  { name: "Instagram", link: "https://instagram.com/meamart", icon: "tabler:brand-instagram" },
];

const navigation = isArabic ? [
  {
    title: "الدليل",
    links: [
      { title: "تصفح الأقسام", link: "/categories" },
      { title: "أضف إعلانك", link: "/ads/create" },
    ],
  },
  {
    title: "ميمارت",
    links: [
      { title: "من نحن", link: "#" },
      { title: "تواصل معنا", link: "#" },
    ],
  },
  {
    title: "الشروط والأحكام",
    links: [
      { title: "سياسات الإعلان", link: "/policies" },
      { title: "سياسة الخصوصية", link: "/policies" },
    ],
  }
] : [
  {
    title: "Directory",
    links: [
      { title: "Browse Categories", link: "/en/categories" },
      { title: "Post an Ad", link: "/en/ads/create" },
    ],
  },
  {
    title: "MeaMart",
    links: [
      { title: "About Us", link: "#" },
      { title: "Contact Us", link: "#" },
    ],
  },
  {
    title: "Legal",
    links: [
      { title: "Advertising Policies", link: "/en/policies" },
      { title: "Privacy Policy", link: "/en/policies" },
    ],
  }
];
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <AppLogo />
        <p class="text-sm leading-6 text-gray-600 dark:text-gray-400 max-w-xs">
          {isArabic 
            ? "دليلك الأول لبيع وشراء كل ما تحتاجه بكل سهولة وموثوقية." 
            : "Your primary directory to buy and sell everything you need easily and reliably."}
        </p>
        <div class="flex space-x-6 rtl:space-x-reverse">
          {socials.map((item) => (
            <a href={item.link} class="text-gray-400 hover:text-primary-500 transition-colors">
              <span class="sr-only">{item.name}</span>
              <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">
              {navigation[0].title}
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              {navigation[0].links.map((item) => (
                <li>
                  <a href={item.link} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">
              {navigation[1].title}
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              {navigation[1].links.map((item) => (
                <li>
                  <a href={item.link} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">
              {navigation[2].title}
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              {navigation[2].links.map((item) => (
                <li>
                  <a href={item.link} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-gray-900/10 dark:border-gray-800 pt-8 sm:mt-20 lg:mt-24">
      <p class="text-xs leading-5 text-gray-500 text-center md:text-start">
        &copy; {new Date().getFullYear()} MeaMart. {isArabic ? "جميع الحقوق محفوظة." : "All rights reserved."}
      </p>
    </div>
  </div>
</footer>
