---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import { useTranslations } from "~/i18n/utils";
import ProductFilters from "~/components/ui/ProductFilters";
import { getCityLabel } from '~/utils/cities';
import { ShoppingBag, Eye, Star, User, CheckCircle, MapPin, MessageSquare, Globe } from "lucide-react";
import { getCollection } from 'astro:content';

export const prerender = false;

const { lang } = Astro.params as { lang: "ar" | "en" };
const t = useTranslations(lang);
const seller: any = null; // No multi-tenant domains in this version yet

// Fetch products from businesses collection
let rawProducts: any[] = [];
try {
  const businesses = await getCollection('businesses');
  rawProducts = businesses.filter((b: any) => b.data?.status !== 'sold').slice(0, 200);
} catch (e) {
  console.error('Failed to fetch products from collection:', e);
}

// Format products with info
const formattedProducts = rawProducts.map((p: any) => {
  const productImages = [p.data.image, ...(p.data.images || [])].filter(Boolean);

  return {
    id: p.id,
    name: p.data.title,
    price: Number(p.data.price || 0),
    sku: p.id || '',
    image: productImages[0] || "/logo.svg",
    images: productImages,
    description: p.data.description || '',
    categories: p.data.category ? [{ name: p.data.category }] : [],
    sellerPhone: p.data.phone || p.data.whatsapp || '',
    sellerName: p.data.contactName || '',
    city: p.data.city || '',
    brand: p.data.customFields?.brand || '',
    brandImage: '',
    supplier: '',
    supplierImage: '',
    attributes: []
  };
});

// Trending products (latest additions)
const trendProducts = formattedProducts.slice(0, 4);

// Seller contact details
const cleanSellerPhone = '';
const whatsappUrl = `https://wa.me/?text=Hello`;
---

<Layout
  title={t['gen.isar.index.4'] || "WhatsApp Catalog"}
  description={t['gen.isar.index.6'] || "Browse WhatsApp catalogs and suppliers"}
>
  <div class="relative pt-24 bg-zinc-50 dark:bg-zinc-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-start md:items-end gap-6">
              <!-- Avatar -->
              <div class="relative -mt-20 md:-mt-24 h-28 w-28 md:h-32 md:w-32 rounded-3xl border-4 border-white dark:border-zinc-900 overflow-hidden bg-zinc-150 dark:bg-zinc-800 shadow-xl shrink-0">
                {seller && seller.avatar ? (
                  <img src={seller.avatar} alt={seller.name} class="h-full w-full object-cover" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center">
                    <User className="h-12 w-12 text-zinc-400" />
                  </div>
                )}
              </div>

              <!-- Meta -->
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-white">
                    {seller.name}
                  </h1>
                  <span class="flex items-center gap-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-2.5 py-1 rounded-full">
                    <CheckCircle className="h-3 w-3" />
                    {(t['gen.isar.index.7'])}
                  </span>
                </div>
                
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-zinc-550 dark:text-zinc-405 font-medium">
                  {seller.phone && (
                    <span class="flex items-center gap-1">
                      <MessageSquare className="h-3.5 w-3.5 text-emerald-500" />
                      {seller.phone}
                    </span>
                  )}
                  {formattedProducts.length > 0 && formattedProducts[0].city && (
                    <span class="flex items-center gap-1">
                      <MapPin className="h-3.5 w-3.5 text-red-500" />
                      {getCityLabel(formattedProducts[0].city, lang)}
                    </span>
                  )}
                </div>
              </div>
            </div>

            <!-- Store CTA -->
            {seller.phone && (
              <a 
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2.5 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 px-6 shadow-md transition active:scale-95 text-sm w-full md:w-auto"
              >
                <MessageSquare className="h-4 w-4" />
                <span>{(t['gen.isar.index.8'])}</span>
              </a>
            )}
          </div>

        </div>
      </div>
    </div>
  ) : (
    <!-- Standard Marketplace Header -->
    <PageHeader
      title={(t['gen.isar.index.9'])}
      description={(t['gen.isar.index.10'])}
    />
  )}

  <Container class="py-16">
    <!-- Trend products (Only show in general marketplace, not when viewing specific seller domain unless desired) -->
    {!seller && trendProducts.length > 0 && (
      <div class="mb-16">
        <h2 class="text-xl font-extrabold text-zinc-900 dark:text-zinc-50 mb-6 flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-amber-500/10 text-amber-500">
            <Star className="h-4 w-4 fill-amber-500" />
          </span>
          {(t['gen.isar.index.11'])}
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          {trendProducts.map((p: any) => (
            <div class="group relative rounded-3xl border border-zinc-200/50 bg-white/40 p-4 shadow-md backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lg flex flex-col justify-between h-full">
              <div>
                <div class="relative aspect-square w-full rounded-full overflow-hidden bg-zinc-100 dark:bg-zinc-800 mb-4">
                  <img src={p.image} alt={p.name} class="w-full h-full object-cover transition duration-300 group-hover:scale-105" />
                  <span class="absolute top-3 left-3 bg-amber-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                    {(t['gen.isar.index.12'])}
                  </span>
                </div>
                
                <div class="space-y-2">
                  <span class="text-[10px] font-semibold text-zinc-400 dark:text-zinc-500 block">
                    SKU: {p.sku || "N/A"}
                  </span>
                  <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 line-clamp-2 min-h-10">
                    <a href={`/${lang}/catalog/${p.id}`} class="hover:text-primary transition-colors">
                      {p.name}
                    </a>
                  </h3>
                </div>
              </div>
              
              <div class="pt-4 mt-4 border-t border-zinc-150 dark:border-zinc-800/50 flex items-center justify-between">
                <span class="text-base font-extrabold text-primary">
                  {t['ads.card.price.format'].replace('{price}', String(p.price)).replace('{symbol}', t['gen.isar.index.13'])}
                </span>
                <a href={`/${lang}/catalog/${p.id}`} class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary transition hover:bg-primary hover:text-white">
                  <Eye className="h-4 w-4" />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Dynamic Products Grid with Filters -->
    <div class="space-y-6">
      <h2 class="text-xl font-extrabold text-zinc-900 dark:text-zinc-50 flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-primary">
          <ShoppingBag className="h-4 w-4" />
        </span>
        {seller ? (t['gen.isar.index.14']) : (t['gen.isar.index.15'])}
      </h2>

      <ProductFilters 
        products={formattedProducts} 
        lang={lang} 
        sellerResolved={!!seller} 
        client:load 
      />
    </div>
  </Container>
</Layout>
