---
export const prerender = true;

import Layout from "~/layouts/Layout.astro";
import AdCard from "~/components/ui/AdCard.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const users = await getCollection("users");
  
  return users.map(user => {
    // Generate paths for all languages
    return ['ar', 'en'].map(lang => ({
      params: { lang, username: user.data.username || user.data.id },
      props: { user: user.data }
    }));
  }).flat();
}

const lang = Astro.params.lang || 'ar';
const { user } = Astro.props;
const t = useTranslations(lang as any);
const safeLang = (lang as any) || "ar";

const allAds = await getCollection("businesses");
// Filter ads for this specific seller
const sellerAds = allAds.filter(ad => ad.data.author_id === user.id && ad.data.published);
---

<Layout title={`${user.name || user.username} | MeaMart`} description={user.description || `كتالوج منتجات ${user.name}`}>
  <!-- Header / Cover -->
  <div class="relative w-full h-48 md:h-64 lg:h-80 bg-zinc-200 dark:bg-zinc-800">
    {user.header ? (
      <img src={user.header} alt="Cover" class="w-full h-full object-cover" />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-emerald-500/80"></div>
    )}
    
    <!-- Pattern Overlay -->
    <div class="absolute inset-0 opacity-10 bg-[url('/img/pattern.svg')] bg-repeat"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10 -mt-16 sm:-mt-24 mb-12">
    <div class="bg-white dark:bg-zinc-900 rounded-3xl p-6 sm:p-8 shadow-2xl border border-zinc-100 dark:border-zinc-800 flex flex-col md:flex-row items-center md:items-end gap-6 text-center md:text-start">
      
      <!-- Avatar -->
      <div class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-full border-4 sm:border-8 border-white dark:border-zinc-900 bg-white dark:bg-zinc-800 overflow-hidden shrink-0 shadow-lg -mt-20 md:-mt-24">
        {user.avatar ? (
          <img src={user.avatar} alt={user.name} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-zinc-100 dark:bg-zinc-800 text-zinc-400">
            <Icon name="lucide:user" class="w-16 h-16" />
          </div>
        )}
      </div>

      <!-- User Info -->
      <div class="flex-1 space-y-2">
        <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white flex items-center justify-center md:justify-start gap-2">
          {user.name || user.username}
          <Icon name="lucide:badge-check" class="w-6 h-6 text-blue-500" />
        </h1>
        <p class="text-primary font-bold">@{user.username || user.id}</p>
        
        {user.description && (
          <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base max-w-2xl mt-4">
            {user.description}
          </p>
        )}
      </div>

      <!-- Contact Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto mt-4 md:mt-0">
        {user.whatsapp && (
          <a href={`https://wa.me/${user.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" class="flex-1 md:flex-none px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl flex items-center justify-center gap-2 transition-colors shadow-lg shadow-emerald-500/20 active:scale-95">
            <Icon name="lucide:message-circle" class="w-5 h-5" />
            واتساب
          </a>
        )}
        {user.phone && (
          <a href={`tel:${user.phone}`} class="flex-1 md:flex-none px-6 py-3 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-white font-bold rounded-xl flex items-center justify-center gap-2 transition-colors active:scale-95">
            <Icon name="lucide:phone" class="w-5 h-5" />
            اتصال
          </a>
        )}
      </div>
    </div>

    <!-- Listings Grid -->
    <div class="mt-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold flex items-center gap-2">
          <Icon name="lucide:layout-grid" class="w-6 h-6 text-primary" />
          كتالوج المنتجات
          <span class="text-sm px-3 py-1 bg-zinc-100 dark:bg-zinc-800 rounded-full text-zinc-500 mr-2">{sellerAds.length} إعلان</span>
        </h2>
      </div>
      
      {sellerAds.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {sellerAds.map(ad => (
            <AdCard 
              title={ad.data.title}
              price={Number(ad.data.price) || 0}
              currency={ad.data.currency}
              category={ad.data.category}
              city={ad.data.city || ''}
              image={ad.data.images?.[0] || ad.data.image || '/images/placeholders/business-1.jpg'}
              sellerPhone={ad.data.whatsapp || ad.data.phone || ''}
              slug={ad.data.slug}
              lang={safeLang}
            />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center bg-zinc-50 dark:bg-zinc-900/50 rounded-3xl border border-zinc-100 dark:border-zinc-800">
          <div class="w-20 h-20 bg-zinc-100 dark:bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-4 text-zinc-400">
            <Icon name="lucide:package-open" class="w-10 h-10" />
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">لا توجد إعلانات</h3>
          <p class="text-zinc-500">هذا المعلن لم يقم بنشر أي منتجات حتى الآن.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
