---
export const prerender = true;

import Layout from "~/layouts/Layout.astro";
import { languages } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import { Icon } from "astro-icon/components";
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  const publishedAds = businesses.filter((b: any) => b.data?.published);
  return Object.keys(languages).flatMap((lang) => {
    return publishedAds.map((ad: any) => ({
      params: { lang, slug: ad.id }
    }));
  });
}

const lang = Astro.params.lang || "ar";
const isArabic = lang === "ar";
const t = useTranslations(lang as keyof typeof languages);

const title = isArabic ? "تعديل الإعلان" : "Edit Ad";
const description = isArabic ? "تعديل بيانات الإعلان الخاص بك" : "Edit your ad details";
const adSlug = Astro.params.slug;
---

<Layout title={title} description={description}>
  <!-- Auth Gate Wrapper -->
  <div id="auth-gate" class="opacity-0 transition-opacity duration-300">
  <div class="min-h-screen py-10" data-slug={adSlug}>
    <div class="container mx-auto px-4 max-w-2xl">
      <!-- Steps Indicator -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-6 text-center text-primary">{title}</h1>
        
        <div class="flex items-center justify-between relative before:absolute before:top-1/2 before:-translate-y-1/2 before:h-1 before:bg-zinc-200 dark:before:bg-zinc-800 before:w-full before:-z-10">
          <div class="step-indicator active" data-step="1">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold bg-primary text-white border-4 border-white dark:border-zinc-950 transition-colors shadow-sm">1</div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-bold whitespace-nowrap text-primary">أساسي</span>
          </div>
          <div class="step-indicator" data-step="2">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold bg-zinc-200 dark:bg-zinc-800 text-zinc-500 border-4 border-white dark:border-zinc-950 transition-colors shadow-sm">2</div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-semibold whitespace-nowrap text-zinc-500">تفاصيل</span>
          </div>
          <div class="step-indicator" data-step="3">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold bg-zinc-200 dark:bg-zinc-800 text-zinc-500 border-4 border-white dark:border-zinc-950 transition-colors shadow-sm">3</div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-semibold whitespace-nowrap text-zinc-500">تواصل</span>
          </div>
          <div class="step-indicator" data-step="4">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold bg-zinc-200 dark:bg-zinc-800 text-zinc-500 border-4 border-white dark:border-zinc-950 transition-colors shadow-sm">4</div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-semibold whitespace-nowrap text-zinc-500">مرفقات</span>
          </div>
        </div>
      </div>

      <form id="create-ad-form" class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl shadow-zinc-200/50 dark:shadow-none border border-zinc-200/50 dark:border-zinc-800/80 p-6 sm:p-10 relative overflow-hidden mt-10">
        
        <!-- Step 1: Basic Details -->
        <div class="form-step active" data-step="1">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="p-2.5 bg-primary/10 text-primary rounded-xl"><Icon name="lucide:info" class="w-6 h-6" /></span>
            التفاصيل الأساسية للإعلان
          </h2>
          
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">عنوان الإعلان <span class="text-red-500">*</span></label>
              <input type="text" name="title" required placeholder="مثال: فلة للبيع، أو كوب قهوة مختصة" class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all placeholder:text-zinc-400" />
              <p class="text-xs text-zinc-500 mt-2 font-medium">تلميح: اكتب عنواناً واضحاً يجذب الانتباه</p>
            </div>
            
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">القسم <span class="text-red-500">*</span></label>
              <div class="relative">
                <select name="category" required class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all appearance-none cursor-pointer">
                  <option value="" disabled selected>اختر القسم...</option>
                  <option value="vehicles">سيارات ومركبات</option>
                  <option value="real-estate">عقار</option>
                  <option value="buy-and-sell">بيع وشراء</option>
                  <option value="services">خدمات</option>
                  <option value="community">مجتمع</option>
                  <option value="jobs">وظائف</option>
                </select>
                <div class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none text-zinc-400">
                  <Icon name="lucide:chevron-down" class="w-5 h-5" />
                </div>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">المدينة <span class="text-red-500">*</span></label>
              <input type="text" name="city" required placeholder="مثال: المنامة، جدة، القاهرة" class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all placeholder:text-zinc-400" />
            </div>

            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">الحي أو معلم بارز</label>
              <input type="text" name="aria" placeholder="مثال: حي الياسمين، أو كورنيش الخبر" class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all placeholder:text-zinc-400" />
            </div>
          </div>
        </div>

        <!-- Step 2: Extra Details -->
        <div class="form-step hidden" data-step="2">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="p-2.5 bg-primary/10 text-primary rounded-xl"><Icon name="lucide:file-text" class="w-6 h-6" /></span>
            عطنا التفاصيل
          </h2>
          
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">وصف الإعلان <span class="text-red-500">*</span></label>
              <textarea name="description" required rows="5" placeholder="اكتب كل التفاصيل اللي تهم الزبون بدقة..." class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all resize-none placeholder:text-zinc-400"></textarea>
            </div>
            
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">السعر</label>
              <input type="text" name="price" placeholder="مثال: 500 ريال، أو على السوم" class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all placeholder:text-zinc-400" />
            </div>
            
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">مميزات الإعلان</label>
              <input type="text" name="tags" placeholder="افصل بينها بفاصلة، مثال: جديد، مستعمل، فخم" class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all placeholder:text-zinc-400" />
            </div>
          </div>
        </div>

        <!-- Step 3: Contact Info -->
        <div class="form-step hidden" data-step="3">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="p-2.5 bg-primary/10 text-primary rounded-xl"><Icon name="lucide:phone" class="w-6 h-6" /></span>
            معلومات التواصل
          </h2>
          
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">اسمك أو اسم المعرض <span class="text-red-500">*</span></label>
              <input type="text" name="name" required placeholder="كيف حاب الزبون يناديك؟" class="w-full px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all placeholder:text-zinc-400" />
            </div>
            
            <div>
              <label class="block text-sm font-bold mb-2 text-zinc-800 dark:text-zinc-200">رقم الجوال <span class="text-red-500">*</span></label>
              <div class="flex items-center gap-2" dir="ltr">
                <select name="countryCode" class="w-28 px-3 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all cursor-pointer">
                  <option value="+966">+966 🇸🇦</option>
                  <option value="+971">+971 🇦🇪</option>
                  <option value="+974">+974 🇶🇦</option>
                  <option value="+965">+965 🇰🇼</option>
                  <option value="+973">+973 🇧🇭</option>
                  <option value="+968">+968 🇴🇲</option>
                  <option value="+20">+20 🇪🇬</option>
                  <option value="+962">+962 🇯🇴</option>
                </select>
                <input type="tel" name="phone" required placeholder="5XXXXXXXX" class="flex-1 px-5 py-3.5 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 bg-transparent focus:border-primary focus:ring-0 outline-none transition-all text-left placeholder:text-zinc-400" />
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-bold mb-3 text-zinc-800 dark:text-zinc-200">طريقة التواصل المفضلة <span class="text-red-500">*</span></label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <label class="flex items-center gap-3 px-4 py-4 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                  <input type="radio" name="callorchat" value="chat" checked class="w-4 h-4 text-primary focus:ring-primary accent-primary" />
                  <span class="font-bold">واتساب فقط</span>
                </label>
                <label class="flex items-center gap-3 px-4 py-4 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                  <input type="radio" name="callorchat" value="call" class="w-4 h-4 text-primary focus:ring-primary accent-primary" />
                  <span class="font-bold">اتصال فقط</span>
                </label>
                <label class="flex items-center gap-3 px-4 py-4 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                  <input type="radio" name="callorchat" value="callnchat" class="w-4 h-4 text-primary focus:ring-primary accent-primary" />
                  <span class="font-bold">واتساب واتصال</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4: Attachments -->
        <div class="form-step hidden" data-step="4">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="p-2.5 bg-primary/10 text-primary rounded-xl"><Icon name="lucide:image" class="w-6 h-6" /></span>
            المرفقات والصور
          </h2>
          
          <div class="space-y-6">
            <div class="border-2 border-dashed border-zinc-300 dark:border-zinc-700 rounded-3xl p-10 text-center hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors cursor-pointer group relative">
              <input id="file-upload" name="photo" type="file" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" multiple accept="image/*" />
              <div class="w-16 h-16 mx-auto bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <Icon name="lucide:upload-cloud" class="w-8 h-8" />
              </div>
              <div class="mt-4 flex flex-col items-center justify-center gap-2 pointer-events-none">
                <p class="font-bold text-lg">اضغط لرفع الصور</p>
                <p class="text-sm text-zinc-500">أو اسحب الصور وأفلتها هنا</p>
              </div>
            </div>
            
            <!-- Uploaded preview placeholder -->
            <div id="image-preview-container" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-4 hidden"></div>
          </div>
        </div>

        <!-- Form Navigation Footer -->
        <div class="mt-10 pt-6 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between gap-4">
          <button type="button" id="prev-btn" class="hidden px-8 py-3.5 rounded-xl font-bold text-zinc-600 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors">
            السابق
          </button>
          
          <div class="flex-1"></div>
          
          <button type="button" id="next-btn" class="px-10 py-3.5 rounded-xl font-bold text-white bg-primary hover:bg-primary/90 hover:scale-105 active:scale-95 transition-all flex items-center gap-2 shadow-lg shadow-primary/25">
            التالي
            <Icon name="lucide:arrow-left" class="w-5 h-5 rtl:-scale-x-100" />
          </button>
          
          <button type="submit" id="submit-btn" class="hidden px-10 py-3.5 rounded-xl font-bold text-white bg-emerald-500 hover:bg-emerald-600 hover:scale-105 active:scale-95 transition-all flex items-center gap-2 shadow-lg shadow-emerald-500/25">
            <span id="submit-text">تحديث الإعلان</span>
            <Icon name="lucide:check-circle" class="w-5 h-5" />
            <span id="submit-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          </button>
        </div>
        
      </form>
    </div>
  </div>
  </div>
</Layout>

<style>
  .step-indicator {
    position: relative;
    z-index: 10;
  }
  .step-indicator.active > div {
    background-color: var(--color-primary);
    color: white;
    border-color: white;
  }
  :global(.dark) .step-indicator.active > div {
    border-color: #09090b; /* zinc-950 */
  }
  .step-indicator.active > span {
    color: var(--color-primary);
    font-weight: bold;
  }
  .step-indicator.completed > div {
    background-color: var(--color-primary);
    color: white;
    border-color: white;
  }
  :global(.dark) .step-indicator.completed > div {
    border-color: #09090b;
  }
  
  /* Make the line colored based on progress */
  .step-indicator.completed::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -100%;
    width: 100%;
    height: 4px;
    background-color: var(--color-primary);
    transform: translateY(-50%);
    z-index: -1;
  }
  
  .step-indicator:first-child::after {
    display: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const lang = document.documentElement.lang || "ar";
    const authGate = document.getElementById('auth-gate');
    
    // Check auth
    try {
      const meRes = await fetch('/api/auth/me');
      if (meRes.ok) {
        const data = await meRes.json();
        if (data.authenticated && data.user) {
          // Show page
          if (authGate) authGate.classList.remove('opacity-0');
        } else {
          window.location.replace(`/${lang}/login`);
          return;
        }
      } else {
        window.location.replace(`/${lang}/login`);
        return;
      }
    } catch (e) {
      window.location.replace(`/${lang}/login`);
      return;
    }
    
    // Original script starts here
    let currentStep = 1;
    const totalSteps = 4;
    
    const steps = document.querySelectorAll(".form-step");
    const indicators = document.querySelectorAll(".step-indicator");
    
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const submitBtn = document.getElementById("submit-btn");
    const form = document.getElementById("create-ad-form");
    
    function updateUI() {
      // Show/Hide steps
      steps.forEach((step, index) => {
        if (index + 1 === currentStep) {
          step.classList.remove("hidden");
        } else {
          step.classList.add("hidden");
        }
      });
      
      // Update indicators
      indicators.forEach((ind, index) => {
        const stepNum = index + 1;
        if (stepNum === currentStep) {
          ind.classList.add("active");
          ind.classList.remove("completed");
        } else if (stepNum < currentStep) {
          ind.classList.add("completed");
          ind.classList.remove("active");
        } else {
          ind.classList.remove("active", "completed");
        }
      });
      
      // Buttons visibility
      if (currentStep === 1) {
        prevBtn?.classList.add("hidden");
      } else {
        prevBtn?.classList.remove("hidden");
      }
      
      if (currentStep === totalSteps) {
        nextBtn?.classList.add("hidden");
        submitBtn?.classList.remove("hidden");
      } else {
        nextBtn?.classList.remove("hidden");
        submitBtn?.classList.add("hidden");
      }
    }
    
    // Validate current step
    function validateStep() {
      const currentStepEl = document.querySelector(`.form-step[data-step="${currentStep}"]`);
      if (!currentStepEl) return true;
      
      const inputs = currentStepEl.querySelectorAll("input[required], select[required], textarea[required]");
      let isValid = true;
      
      inputs.forEach(input => {
        const el = input as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (!el.value.trim()) {
          isValid = false;
          el.classList.add("border-red-500");
          el.classList.remove("border-zinc-200", "dark:border-zinc-800");
          // Remove error styling on input
          el.addEventListener("input", () => {
            el.classList.remove("border-red-500");
            el.classList.add("border-zinc-200", "dark:border-zinc-800");
          }, { once: true });
        }
      });
      
      return isValid;
    }
    
    nextBtn?.addEventListener("click", () => {
      if (validateStep() && currentStep < totalSteps) {
        currentStep++;
        updateUI();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
    
    prevBtn?.addEventListener("click", () => {
      if (currentStep > 1) {
        currentStep--;
        updateUI();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
    

    // Form Submission Logic (Edit Mode)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep()) return;
      
      const submitTextEl = document.getElementById('submit-text');
      const submitSpinnerEl = document.getElementById('submit-spinner');
      
      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
      if (submitTextEl) submitTextEl.textContent = 'جاري التحديث...';
      if (submitSpinnerEl) submitSpinnerEl.classList.remove('hidden');
      
      const formData = new FormData(form as HTMLFormElement);
      
      // Collect uploaded files from preview
      const fileInput = document.getElementById('file-upload') as HTMLInputElement;
      if (fileInput?.files) {
        formData.delete('photo');
        formData.delete('images');
        const maxFiles = Math.min(fileInput.files.length, 4);
        for (let i = 0; i < maxFiles; i++) {
          formData.append('images', fileInput.files[i]);
        }
      }
      
      try {
        const response = await fetch('/api/submit-ad', {
          method: 'POST',
          body: formData
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
          alert('تم تحديث الإعلان بنجاح!');
          window.location.href = result.url || `/${document.documentElement.lang}/dashboard`;
        } else {
          alert('حدث خطأ أثناء التحديث: ' + (result.error || 'خطأ غير معروف'));
        }
      } catch (error) {
        alert('حدث خطأ في الاتصال بالخادم. يرجى المحاولة لاحقاً.');
        console.error(error);
      } finally {
        if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
        if (submitTextEl) submitTextEl.textContent = 'تحديث الإعلان';
        if (submitSpinnerEl) submitSpinnerEl.classList.add('hidden');
      }
    });
  });
</script>
