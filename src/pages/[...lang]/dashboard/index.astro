---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import DashboardSubNav from "~/components/dashboard/DashboardSubNav.astro";
import { defaultLang } from "~/i18n/ui";
import { useTranslations, getLangFromUrl } from "~/i18n/utils";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isRtl = lang === "ar";

import { getCollection } from "astro:content";

const sessionCookie = Astro.cookies.get("meamart_session")?.value;
let session = Astro.locals.userSession;
if (!session && sessionCookie) {
  try {
    session = JSON.parse(decodeURIComponent(atob(sessionCookie)));
  } catch (e) {}
}

if (!session) {
  return Astro.redirect(`/${lang}/login`);
}

const allAds = await getCollection("businesses");
const sellerAds = allAds.filter((ad: any) => 
  ad.data?.contactEmail === session.email || 
  ad.data?.contactName === session.name || 
  ad.data?.ownerId === session.id
);

const sellerProducts: any[] = [];
const sellerAddresses: any[] = [];
const needsPhoneVerification = false;

const activeAdsCount = sellerAds.filter((ad: any) => ad.data?.status !== "sold").length;
const expiredAdsCount = sellerAds.filter((ad: any) => ad.data?.status === "sold").length;
const featuredAdsCount = sellerAds.filter((ad: any) => ad.data?.featured).length;

const headerTitle = t["seller.dashboard.header.title"] || "لوحة التحكم";
const headerSubtitle = (t["seller.dashboard.header.subtitle"] || "مرحباً بك {name}").replace("{name}", session.name || "");
---

<Layout title={headerTitle} description={headerSubtitle}>
  <PageHeader title={headerTitle} description={headerSubtitle} />

  {needsPhoneVerification ? (
    <div class="max-w-7xl mx-auto mb-6 px-4">
      <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/30 dark:bg-amber-900/10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-semibold">{t["seller.dashboard.header.verified"]}</p>
            <p class="text-xs text-amber-700/80 mt-1">
              {t["seller.dashboard.phoneWarning.body"]}
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/api/auth/logout" class="px-3 py-2 rounded-md text-sm font-semibold text-amber-800 bg-amber-100 hover:bg-amber-200">
              {t["seller.dashboard.actions.logout"] || "تسجيل الخروج"}
            </a>
            <a href={`/${lang}/ads/create`} class="px-3 py-2 rounded-md text-sm font-semibold bg-primary text-white hover:bg-primary/90">
              {t["seller.dashboard.actions.create"] || "إنشاء إعلان"}
            </a>
          </div>
        </div>
      </div>
    </div>
  ) : null}

  <Container class="pb-20 max-w-7xl">
    <div class="mb-8 flex flex-col items-center justify-between gap-6 rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 md:flex-row">
      <div class="flex items-center gap-4">
        <div class="h-16 w-16 rounded-full overflow-hidden bg-primary/10 shadow-md shrink-0 flex items-center justify-center">
          <div class="text-2xl font-bold text-primary">
            {session.name?.charAt(0).toUpperCase()}
          </div>
        </div>

        <div class={`space-y-1 ${isRtl ? "text-center md:text-end" : "text-center md:text-start"}`}>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">{session.name}</h3>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">{session.phone}</p>
          <p class="text-xs text-zinc-400 dark:text-zinc-500">{session.email}</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
        <a href={`/${lang}/@${session.username}`} class="flex-1 sm:flex-initial rounded-full px-4 py-2.5 text-xs font-bold border border-zinc-200 dark:border-zinc-800 text-emerald-600 border-emerald-500/30 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 text-center">
          {t["seller.dashboard.nav.storePage"] || "صفحة المتجر"}
        </a>
        <a href={`/${lang}/dashboard/qr-manager`} class="flex-1 sm:flex-initial rounded-full px-4 py-2.5 text-xs font-bold border border-zinc-200 dark:border-zinc-800 text-primary border-primary/30 hover:bg-primary/5 text-center">
          {t["seller.subnav.qr"] || "إدارة الباركود"}
        </a>
        <a href={`/${lang}/dashboard/profile`} class="flex-1 sm:flex-initial rounded-full px-4 py-2.5 text-xs font-bold border border-zinc-200 dark:border-zinc-800 text-violet-600 border-violet-500/30 hover:bg-violet-50 dark:hover:bg-violet-900/20 text-center">
          {t["seller.dashboard.nav.storeSettings"] || "إعدادات المتجر"}
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mb-8">
      <div class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">{t["seller.dashboard.stats.active"] || "نشط"}</p>
            <h4 class="mt-2 text-3xl font-extrabold text-zinc-900 dark:text-zinc-50">{activeAdsCount}</h4>
          </div>
        </div>
      </div>
      <div class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">{t["seller.dashboard.stats.expired"] || "منتهي"}</p>
            <h4 class="mt-2 text-3xl font-extrabold text-zinc-900 dark:text-zinc-50">{expiredAdsCount}</h4>
          </div>
        </div>
      </div>
      <div class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">{t["seller.dashboard.stats.featured"] || "مميز"}</p>
            <h4 class="mt-2 text-3xl font-extrabold text-zinc-900 dark:text-zinc-50">{featuredAdsCount}</h4>
          </div>
        </div>
      </div>
    </div>

    <DashboardSubNav
      lang={lang}
      activeTab="ads"
      productsCount={sellerProducts.length}
    />

    <div class="mt-16 text-center p-12 border-2 border-dashed border-zinc-200 dark:border-zinc-800 rounded-3xl bg-white/40 dark:bg-zinc-900/40">
      <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">لا توجد إعلانات</h3>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">ابدأ بإنشاء إعلانك الأول ليظهر هنا.</p>
      <a href={`/${lang}/ads/create`} class="mt-4 inline-block bg-primary hover:bg-primary/90 text-white rounded-full px-6 py-2 shadow-md">
        إنشاء إعلان
      </a>
    </div>
  </Container>
</Layout>
