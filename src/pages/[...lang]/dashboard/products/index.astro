---
export const prerender = false;

import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import DashboardSubNav from "~/components/dashboard/DashboardSubNav.astro";
import { Card, CardContent, CardHeader, CardTitle } from '~/components/catalog/ui/card';

import { getCollection } from "astro:content";
import { GoogleSheetsDatabase } from "~/lib/catalog/google-sheets";

const lang = getLangFromUrl(Astro.url);
const isRtl = lang === "ar";
const t = useTranslations(lang);

let session = Astro.locals.userSession;

let productsCount = 0;
let products: any[] = [];
let error = null;

if (session) {
  const users = await getCollection('users');
  const userProfile = users.find((u: any) => u.data.email === session.email || u.data.username === session.id || u.id === session.id);
  const googleSheetId = userProfile?.data.google_sheet_id;

  if (googleSheetId) {
    const clientEmail = import.meta.env.GOOGLE_CLIENT_EMAIL || process.env.GOOGLE_CLIENT_EMAIL;
    const privateKey = import.meta.env.GOOGLE_PRIVATE_KEY || process.env.GOOGLE_PRIVATE_KEY;
    
    if (clientEmail && privateKey) {
      try {
        const db = new GoogleSheetsDatabase(googleSheetId, clientEmail, privateKey);
        products = await db.getProducts();
        productsCount = products.length;
      } catch (err: any) {
        error = err.message;
      }
    } else {
      error = lang === 'ar' ? "مفاتيح Google API غير متوفرة في إعدادات الخادم." : "Google API keys are not configured on the server.";
    }
  } else {
    error = lang === 'ar' ? "لم تقم بربط Google Sheet بملفك الشخصي بعد." : "You have not linked a Google Sheet to your profile yet.";
  }
}

const title = lang === 'ar' ? "إدارة المنتجات" : "Manage Products";
const description = lang === 'ar' ? "أضف وعدل منتجاتك المرتبطة بنظام المستودع و Google Sheets" : "Add and edit your products linked to Google Sheets";
---

<Layout title={title} description={description}>
  <PageHeader title={title} description={description} />

  <Container class="pb-24 max-w-7xl">
    <DashboardSubNav
      lang={lang}
      activeTab="products"
      productsCount={productsCount}
    />

    <div class="space-y-6 pt-2">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50">{title}</h1>
          <p class="text-zinc-500 dark:text-zinc-400 mt-1">{description}</p>
        </div>
        <div class="flex gap-2">
          <button class="bg-emerald-600 hover:bg-emerald-700 text-white rounded-full px-6 py-2 shadow-md flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            {lang === 'ar' ? 'مزامنة مع Google Sheets' : 'Sync with Google Sheets'}
          </button>
          <a href={`/${lang}/dashboard/products/create`} class="bg-primary hover:bg-primary/90 text-white rounded-full px-6 py-2 shadow-md text-center">
            + {lang === 'ar' ? 'إضافة منتج جديد' : 'Add New Product'}
          </a>
        </div>
      </div>

      {error && (
        <div class="p-4 bg-red-50 text-red-800 rounded-2xl border border-red-200 dark:bg-red-900/20 dark:border-red-900/30">
          Error: {error}
        </div>
      )}

      {products.length === 0 && !error ? (
        <div class="text-center p-12 border-2 border-dashed border-zinc-200 dark:border-zinc-800 rounded-3xl bg-white/40 dark:bg-zinc-900/40 shadow-xs backdrop-blur-md mt-8">
          <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">{lang === 'ar' ? 'لا توجد منتجات' : 'No Products'}</h3>
          <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">{lang === 'ar' ? 'قم بإضافة منتجك الأول ليرتبط بنظام Google Sheets.' : 'Add your first product to link it with Google Sheets.'}</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mt-8">
          {products.map((product: any) => (
            <Card className="hover:border-primary/50 hover:shadow-lg transition-all duration-300 border-zinc-200/50 dark:border-zinc-800/50 rounded-3xl overflow-hidden bg-white/40 dark:bg-zinc-900/40 backdrop-blur-md">
              {product.image && (
                <div class="aspect-video w-full overflow-hidden bg-zinc-100 dark:bg-zinc-800">
                  <img src={product.image} alt={product.item_name} class="w-full h-full object-cover" />
                </div>
              )}
              <CardHeader className="p-4 pb-2">
                <CardTitle className="text-lg font-bold text-zinc-900 dark:text-zinc-50 truncate">{product.item_name}</CardTitle>
              </CardHeader>
              <CardContent className="p-4 pt-0 text-zinc-500 dark:text-zinc-400 text-sm">
                <div class="flex justify-between items-center mt-2">
                  <span class="font-bold text-primary">{product.standard_rate || 0} SAR</span>
                  <span class="text-xs bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded-md">{product.item_group}</span>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      )}
    </div>
  </Container>
</Layout>
