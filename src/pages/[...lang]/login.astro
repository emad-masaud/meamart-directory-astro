---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import LoginTabsClient from '~/components/auth/LoginTabsClient';
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';

export const prerender = false;

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "ar" } },
    { params: { lang: "en" } },
  ];
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '845217154240-h0eufomg31l04o71focig5v74pqu7v5d.apps.googleusercontent.com';

if (Astro.locals.userSession || Astro.cookies.get('meamart_session')?.value) {
  const redirectTarget = Astro.url.searchParams.get('redirect') || `/${lang}/dashboard`;
  return Astro.redirect(redirectTarget);
}
---

<Layout title={lang === 'ar' ? "تسجيل الدخول - ميمارت" : "Login - MeaMart"} description={lang === 'ar' ? "تسجيل الدخول إلى حسابك" : "Login to your account"}>
  <PageHeader title={lang === 'ar' ? "تسجيل الدخول" : "Sign In"} description={lang === 'ar' ? "قم بتسجيل الدخول للوصول إلى لوحة التحكم الخاصة بك." : "Sign in to access your dashboard."} />

  <Container class="pb-24 pt-8 max-w-md">
    <LoginTabsClient 
      client:load
      signinLabel={lang === 'ar' ? "تسجيل الدخول" : "Sign In"}
      registerLabel={lang === 'ar' ? "تسجيل حساب جديد" : "Register"}
      signinDesc={lang === 'ar' ? "ادخل بياناتك للدخول إلى حسابك" : "Enter your credentials to sign in"}
      registerDesc={lang === 'ar' ? "انشئ حساب جديد للبدء" : "Create a new account to get started"}
      googleBtn={lang === 'ar' ? "تسجيل الدخول باستخدام جوجل" : "Sign in with Google"}
      googleRegister={lang === 'ar' ? "انشاء حساب باستخدام جوجل" : "Register with Google"}
      googleClientId={googleClientId}
      lang={lang}
    />
  </Container>
</Layout>

<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
<script is:inline>
  async function handleCredentialResponse(response) {
    if (!response.credential) {
      alert("لم يتم العثور على التوكن من جوجل");
      return;
    }
    
    try {
      const res = await fetch('/api/auth/google', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ credential: response.credential })
      });
      
      const result = await res.json();
      
      if (res.ok && result.success) {
        window.location.href = `/${document.documentElement.lang || 'ar'}/dashboard`;
      } else {
        alert('حدث خطأ: ' + (result.error || 'غير معروف'));
      }
    } catch (error) {
      alert('حدث خطأ في الاتصال بالخادم');
      console.error(error);
    }
  }
</script>
