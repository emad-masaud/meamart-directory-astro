---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import LoginTabsClient from '~/components/auth/LoginTabsClient';
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';

export const prerender = false;

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "ar" } },
    { params: { lang: "en" } },
  ];
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '845217154240-h0eufomg31l04o71focig5v74pqu7v5d.apps.googleusercontent.com';

if (Astro.locals.userSession || Astro.cookies.get('meamart_session')?.value) {
  const redirectTarget = Astro.url.searchParams.get('redirect') || `/${lang}/dashboard`;
  return Astro.redirect(redirectTarget);
}
---

<Layout title={t('auto.login_meamart')} description={t('auto.login_to_your_accoun')}>
  <PageHeader title={t('auto.sign_in')} description={t('auto.sign_in_to_access_yo')} />

  <Container class="pb-24 pt-8 max-w-md">
    <LoginTabsClient 
      client:load
      signinLabel={t('auto.sign_in')}
      registerLabel={t('auto.register')}
      signinDesc={t('auto.enter_your_credentia')}
      registerDesc={t('auto.create_a_new_account')}
      googleBtn={t('auto.sign_in_with_google')}
      googleRegister={t('auto.register_with_google')}
      googleClientId={googleClientId}
      lang={lang}
    />
  </Container>
</Layout>

<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
<script is:inline>
  async function handleCredentialResponse(response) {
    if (!response.credential) {
      alert("لم يتم العثور على التوكن من جوجل");
      return;
    }
    
    try {
      const res = await fetch('/api/auth/google', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ credential: response.credential })
      });
      
      const result = await res.json();
      
      if (res.ok && result.success) {
        window.location.href = `/${document.documentElement.lang || 'ar'}/dashboard`;
      } else {
        alert('حدث خطأ: ' + (result.error || 'غير معروف'));
      }
    } catch (error) {
      alert('حدث خطأ في الاتصال بالخادم');
      console.error(error);
    }
  }
</script>
