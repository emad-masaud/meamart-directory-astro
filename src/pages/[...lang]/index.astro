---
import { languages } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import Layout from "~/layouts/Layout.astro";
import Schema from "~/components/layout/Schema.astro";
import Hero from "~/components/sections/Hero.astro";
import HomeCategories from "~/components/sections/home/HomeCategories.astro";
import HomeFeaturedAds from "~/components/sections/home/HomeFeaturedAds.astro";
import HomePopularCategories from "~/components/sections/home/HomePopularCategories.astro";

import HomeLocations from "~/components/sections/home/HomeLocations.astro";
import AdBanner from '~/components/ui/AdBanner.astro';
import Container from '~/components/ui/Container.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "ar" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const safeLang = lang || 'ar';
const t = useTranslations(safeLang as keyof typeof languages);
---

<Layout
  title={t['hero.title']}
  description={t['hero.subtitle']}
>
  <Schema item={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": t['brand.name'],
    "url": Astro.url.href
  }} />

  <!-- Hero Section -->
  <Hero 
    lang={safeLang}
    primaryCta={{ text: t['hero.getStarted'], href: `/${safeLang}/ads/create` }}
  />

  <!-- Categories Slider -->
  <HomeCategories lang={safeLang} />

  <!-- بنر إعلاني تحت سلايدر الأقسام -->
  <Container class="py-4">
    <AdBanner position="belowCategories" lang={safeLang} />
  </Container>

  <!-- Featured Ads Carousel -->
  <HomeFeaturedAds lang={safeLang} />

  <!-- بنر إعلاني بعد سلايدر الإعلانات المميزة -->
  <Container class="py-4">
    <AdBanner position="afterSliders" lang={safeLang} />
  </Container>

  <!-- Popular Categories Grid -->
  <HomePopularCategories lang={safeLang} />

  <!-- Custom Field Highlights -->
  <!-- <HomeCustomFields lang={safeLang} /> -->

  <!-- بنر إعلاني إضافي بعد الحقول المخصصة -->
  <Container class="py-4">
    <AdBanner position="afterSliders" lang={safeLang} />
  </Container>

  <!-- Top Location Ads -->
  <HomeLocations lang={safeLang} />
</Layout>