---
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return [
    { params: { lang: "ar" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const isArabic = lang === "ar";

const title = isArabic ? "أضف إعلانك" : "Post an Ad";
const description = isArabic ? "أضف إعلانك الجديد في ميمارت" : "Post your new ad on MeaMart";
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="container mx-auto px-4 py-20 text-center max-w-2xl">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-10">
      <h1 class="text-3xl font-bold mb-4">{title}</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        {isArabic 
          ? "هذه الصفحة تحت الإنشاء. قريباً ستتمكن من إضافة إعلاناتك مباشرة." 
          : "This page is under construction. Soon you will be able to post ads directly."}
      </p>
      <a href={`/${lang}/`} class="inline-flex items-center justify-center rounded-full bg-primary-500 text-white px-8 py-3 font-bold hover:bg-primary-600 transition-all shadow-sm">
        {isArabic ? "العودة للرئيسية" : "Back to Home"}
      </a>
    </div>
  </div>
</BaseLayout>
