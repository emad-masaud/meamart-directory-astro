---
import BaseLayout from "@layouts/BaseLayout.astro";
import BusinessCard from "@components/directory/cards/BusinessCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  
  const paths: any[] = [];
  categories.forEach((category) => {
    paths.push({
      params: { lang: "ar", slug: category.data.slug },
      props: { category },
    });
    paths.push({
      params: { lang: "en", slug: category.data.slug },
      props: { category },
    });
  });
  
  return paths;
}

const { lang } = Astro.params;
const { category } = Astro.props;
const isArabic = lang === "ar";

const name = isArabic ? category.data.nameAr : category.data.nameEn;
const description = isArabic ? category.data.descriptionAr : category.data.descriptionEn;

const allBusinesses = await getCollection("businesses");
const categoryBusinesses = allBusinesses.filter(
  (b) => b.data.category === category.data.slug && b.data.published !== false
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": name,
  "description": description
};
---

<BaseLayout title={name} description={description} lang={lang} type="website" jsonLd={jsonLd}>
  <div class="bg-gray-50 dark:bg-gray-800/50 border-b border-gray-200 dark:border-gray-700 py-12">
    <div class="container mx-auto px-4 max-w-7xl text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">{name}</h1>
      <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">{description}</p>
    </div>
  </div>
  
  <div class="container mx-auto px-4 max-w-7xl py-12">
    {categoryBusinesses.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {categoryBusinesses.map((business) => (
          <BusinessCard business={business.data} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <h3 class="text-xl font-bold text-gray-400 mb-2">{isArabic ? "لا توجد إعلانات هنا بعد" : "No ads found here yet"}</h3>
        <a href={`/${lang}/ads/create`} class="text-primary-600 hover:underline">{isArabic ? "كن أول من يعلن!" : "Be the first to post!"}</a>
      </div>
    )}
  </div>
</BaseLayout>
